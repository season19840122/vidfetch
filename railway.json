{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "buildCommand": null,
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/Dockerfile",
      "/railway.json",
      "/package.json",
      "/package-lock.json",
      "/server/**",
      "/client/**"
    ]
  },
  "deploy": {
    "healthcheckPath": null,
    "healthcheckTimeout": null,
    "overlapSeconds": 0,
    "drainingSeconds": 0,
    "restartPolicyType": "ON_FAILURE"
  }
}

# ===== 在线视频下载管理器 环境变量 =====

# 服务端口
PORT=45392
HOST=0.0.0.0

# 数据目录（数据库 + 下载文件都在这里）
DATA_DIR=./data

# 数据库文件路径（留空则使用 DATA_DIR/app.db）
# DB_PATH=

# 下载文件保存目录（留空则使用 DATA_DIR/downloads）
# DOWNLOAD_DIR=

# 默认最大并发下载数（1/2/3/5/10）
MAX_CONCURRENT=3

# 默认下载质量（best / 2160p / 1440p / 1080p / 720p / 480p / 360p）
DEFAULT_QUALITY=1080p

# 默认文件格式（mp4 / webm / mkv / m4a）
DEFAULT_FORMAT=mp4

# 网络：最大下载速度（字节/秒，0 表示不限速）
MAX_SPEED=0

# 网络：请求超时（毫秒）
TIMEOUT=60000

# 网络：自动重试次数
RETRY_COUNT=3

# 浏览器 Cookies 来源（解决 YouTube "Sign in to confirm you're not a bot" 人机验证）
# 可选：chrome / firefox / edge / safari / brave / chromium；留空或 off 表示不使用
# 注：需本机装有对应浏览器且已登录；Docker 容器内无浏览器，应保持为空
# YTDLP_COOKIES_FROM_BROWSER=chrome

# 云端部署（Railway 等）请勿使用上方的浏览器来源。
# 从本机导出 Netscape 格式 cookies.txt 后，转为单行 Base64 并作为平台私密变量设置。
# macOS/Linux：base64 < cookies.txt | tr -d '\n'
# YTDLP_COOKIES_BASE64=
# 也可直接指定服务器上已有的 Cookie 文件路径（本地/自建服务器适用）。
# YTDLP_COOKIES_FILE=

# yt-dlp 可执行文件路径（留空则自动从 PATH 查找）
# YTDLP_PATH=

# 下载模拟模式：auto=缺少 yt-dlp 时自动降级; 1=强制模拟; 0=关闭模拟
SIMULATE=auto

# 前端开发服务器地址（仅开发环境代理使用）
VITE_API_TARGET=http://localhost:45392

# 前端 API 后端地址（仅静态站点部署时使用，如 GitHub Pages / Netlify）：
# 构建前端时指定你的后端地址，前端将请求该地址的 /api；留空则请求同源 /api
# VITE_API_BASE=https://your-backend.example.com
